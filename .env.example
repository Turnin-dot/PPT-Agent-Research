# Copy to .env. Never commit real keys. Model IDs are configurable, not availability guarantees.
DASHSCOPE_API_KEY=
ARK_API_KEY=
DEEPSEEK_API_KEY=
PPT_AGENT_DEMO_MODEL=qwen:qwen3.8-flash
PPT_AGENT_PLANNING_REVIEW_MODEL=qwen:qwen3.8-flash
PPT_AGENT_PAGE_REVIEW_MODEL=doubao:doubao-seed-2-1-turbo-260628
PPT_AGENT_PAGE_REVIEW_MODEL_MAX_RETRIES=0
PPT_AGENT_ASSET_INSPECTION_MODEL=deepseek:deepseek-flash
# Optional portable overrides; leave unset for PATH/local node_modules/managed Chromium.
# PPT_AGENT_NODE=/path/to/node
# PPT_AGENT_NODE_MODULES=/path/to/repo/node_modules
# PPT_AGENT_CHROMIUM=/path/to/chromium
# PPT_AGENT_MINERU=/path/to/mineru
# PPT_AGENT_MINERU_DEVICE=cpu
